# Application Settings
PROJECT_NAME="Video Viewer API"
API_V1_STR="/api/v1"
PORT=8000

# Redis Connection
# For Local Docker Redis container (used by default in docker compose):
REDIS_URL="redis://redis:6379/0"
# For Local Redis on host machine:
# REDIS_URL="redis://localhost:6379/0"
# For Remote Upstash Redis (TLS enabled):
# REDIS_URL="rediss://default:<password>@<host>.upstash.io:6379"

# Cache Configuration (in seconds)
CACHE_TTL_SECONDS=7200

# YouTube Scraping Authentication (Optional base64 encoded cookies.txt)
YOUTUBE_COOKIES_BASE64=""
